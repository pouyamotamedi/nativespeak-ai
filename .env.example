# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional but recommended for dedicated Whisper STT + American TTS (nova).
# If unset, STT falls back to Gemini multimodal and TTS falls back to browser en-US voice.
OPENAI_API_KEY=""

# GAPGPT_API_KEY: Optional Iranian gateway (https://gapgpt.app/platform-v2) for Rial top-ups.
# Used first for /api/tts. Chat Completions OpenAI-compatible at api.gapgpt.app/v1.
# NOTE: Multimodal Gemini audio analysis in this app still prefers GEMINI_API_KEY (official SDK).
# Whisper STT is not clearly available on GapGPT — keep OPENAI_API_KEY or Gemini STT for transcription.
GAPGPT_API_KEY=""
GAPGPT_BASE_URL="https://api.gapgpt.app/v1"
GAPGPT_TTS_URL="https://gapgpt.app/api/v1/tts"
GAPGPT_CHAT_MODEL="gpt-4o"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
